# 前端环境变量（VITE_ 前缀会被 Vite 注入）

# 推荐：走后端代理，API Key 留在服务端、不进前端 bundle
VITE_API_BASE_URL=http://localhost:3001/api
VITE_LLM_MODEL=deepseek-v3

# 后端 HTTP API（账号 / 数据持久化），对应 server 的 HTTP_PORT
VITE_SERVER_URL=http://localhost:3002

# 降级方案（仅无后端的独立演示时启用；注意 key 会被打进前端代码，存在泄露风险）
# VITE_OPENAI_API_KEY=your-api-key
# VITE_OPENAI_BASE_URL=https://api.qnaigc.com/v1
