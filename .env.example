# AI 英语口语陪练 - 环境变量模板
# 复制为 .env 并填入真实值

# OpenAI
OPENAI_API_KEY=sk-xxx

# 发音评测服务商：iflytek | azure | estimate（本地估算，无需 API）
# 不填则按下方已配置的凭证自动选择
PRONUNCIATION_PROVIDER=iflytek

# 科大讯飞语音评测（流式版）https://www.xfyun.cn/services/ise
XFYUN_APP_ID=your_app_id
XFYUN_API_KEY=your_api_key
XFYUN_API_SECRET=your_api_secret

# Azure Speech 发音评测 https://portal.azure.com
AZURE_SPEECH_KEY=your_azure_key
AZURE_SPEECH_REGION=eastasia

# Server
PORT=3000
NODE_ENV=development
