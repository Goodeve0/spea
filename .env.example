# AI 英语口语陪练 - 环境变量模板
# 复制为 .env 并填入真实值

# OpenAI
OPENAI_API_KEY=sk-xxx

# 发音评测服务商：iflytek | azure | estimate（本地估算，无需 API）
# 不填则按下方已配置的凭证自动选择
PRONUNCIATION_PROVIDER=iflytek

# 科大讯飞语音评测（流式版）https://www.xfyun.cn/services/ise
# 同一套 AppId/Key/Secret 也用于"在线语音合成 TTS"（v2/tts）
# TTS 需在控制台对该 AppId 单独开通"在线语音合成（流式版）"服务
# 控制台：https://console.xfyun.cn/services/tts -> 选择对应 AppId 开通
# 英文音色 ID 速查（前端 SettingsPanel 下拉同列表）：
#   x4_EnUs_Catherine（女 · 美式，默认）
#   x4_EnUs_Laura     （女 · 美式）
#   x4_EnUs_Alex      （男 · 美式）
#   x4_EnUs_Henry     （男 · 美式）
#   x_EnUs_John       （男 · 美式 · 经典）
XFYUN_APP_ID=your_app_id
XFYUN_API_KEY=your_api_key
XFYUN_API_SECRET=your_api_secret

# Azure Speech 发音评测 https://portal.azure.com
AZURE_SPEECH_KEY=your_azure_key
AZURE_SPEECH_REGION=eastasia

# SiliconFlow：SenseVoice 语音转写（POST /asr）+ 可分流查词/翻译以缓解 qnaigc 429
# 控制台：https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=sk-xxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# Server
PORT=3000
NODE_ENV=development

# 账号 / 数据持久化（HTTP API 3002）
DATABASE_URL="file:./dev.db"
JWT_SECRET="dev-secret-change-me-in-production"
HTTP_PORT=3002
WS_PORT=3001
